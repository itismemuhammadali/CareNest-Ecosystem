# Used by: supabase functions serve --env-file supabase/.env.local
# Copy: cp supabase/.env.example supabase/.env.local
#
# Local: URL + service_role from `supabase status` (or `supabase status -o env`).
# Hosted: same keys from Dashboard → Settings → API (use **rotated** service_role).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
WEBHOOK_SECRET=
APP_BASE_URL=http://127.0.0.1:54321
FCM_PROJECT_ID=
# One-line JSON: jq -c . < service-account.json
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_JSON_FILE=
RESEND_API_KEY=
EMAIL_FROM=StarSitters <noreply@starsitters.app>
