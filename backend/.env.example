# =============================================================================
# Star Sitters — backend environment template (BACKEND.md §22)
# =============================================================================
# Copy to `.env` at repo root (gitignored):
#   cp .env.example .env
# Fill values from `supabase status` (local) or Supabase Dashboard → Settings (cloud).
# Never commit `.env`. If keys were ever exposed, rotate them — see docs/SECRETS_AND_ENV.md
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase project (local OR hosted)
# -----------------------------------------------------------------------------
# Local defaults from `supabase status`:
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Hosted only: project ref from URL https://<REF>.supabase.co
SUPABASE_PROJECT_REF=
# PAT: Dashboard → Account → Access Tokens (for `supabase link`, CI, `secrets set`)
SUPABASE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Database webhooks → Edge Functions (same value in Dashboard webhook header)
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=

# Hosted: Edge Function secrets must include WEBHOOK_SECRET (same value as below).
# Database → Webhooks → INSERT on public.notifications → URL
#   https://<PROJECT_REF>.supabase.co/functions/v1/send_push
# Add HTTP header: x-webhook-secret: <exactly WEBHOOK_SECRET>
# (send_push compares req.headers.get("x-webhook-secret") to Deno.env WEBHOOK_SECRET.)

# -----------------------------------------------------------------------------
# Auth password reset / magic links (Supabase Auth — NOT Edge Functions)
# -----------------------------------------------------------------------------
# Hosted: Dashboard → Authentication → SMTP (production) or use built-in mailer (dev/low volume).
# Dashboard → URL Configuration → add Redirect URLs including .../reset-password
# See starsitters-backend/docs/BACKEND.md → "Auth Configuration" →
#   "Password reset and Auth transactional email".
# Local: supabase/config.toml [inbucket] + `supabase start` → emails in Inbucket (supabase status).

# -----------------------------------------------------------------------------
# Guardian consent email (Edge: send_guardian_consent_email)
# -----------------------------------------------------------------------------
# Public site or deep-link base (consent URL). Use local Studio or app URL in dev.
APP_BASE_URL=http://127.0.0.1:54321
# Optional until system_config.email_provider = 'resend'
RESEND_API_KEY=
EMAIL_FROM=StarSitters <noreply@starsitters.app>

# -----------------------------------------------------------------------------
# Push — FCM HTTP v1 (Edge: send_push) — only when system_config.fcm_provider = live
# Firebase Console → Project settings → Service accounts → Generate new key
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=
# Prefer FILE over inline JSON: long JSON (even single-quoted) can break the Supabase CLI
# dotenv parser (`supabase link`, etc.) with errors like "unexpected character '\' in variable name".
FCM_SERVICE_ACCOUNT_JSON=
# Path to minified JSON (gitignored). Example after copying your key from Firebase:
#   mkdir -p supabase/.secrets && jq -c . < ~/Downloads/your-key.json > supabase/.secrets/star-sitter-fcm.json
FCM_SERVICE_ACCOUNT_JSON_FILE=

# -----------------------------------------------------------------------------
# Optional CI / automation (GitHub Actions — prefer encrypted secrets there)
# -----------------------------------------------------------------------------
# ENABLE_SUPABASE_DB_PUSH is a GitHub *variable*, not this file. See README + workflow.
