# =============================================================================
# Secrets & local env (never commit real values)
# =============================================================================
.env
.env.from-status
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Allow committed templates only:
!.env.example
!.env.*.example
*.pem
*.p8
*-service-account*.json

# =============================================================================
# Supabase CLI
# =============================================================================
supabase/.temp/
supabase/.branches/
.branches
.temp
**/supabase/.env
**/supabase/.env.local
!supabase/.env.example
supabase/.secrets/**
!supabase/.secrets/.gitkeep

